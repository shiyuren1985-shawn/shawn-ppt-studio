        "style-src": "'self'",
        "img-src": "'self' http://127.0.0.1:*",
        "connect-src": "'self' http://127.0.0.1:*",
        "frame-src": "http://127.0.0.1:*",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
