{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shawn PPT Studio",
  "version": "0.1.0",
  "identifier": "com.shawn.ppt-studio",
  "build": {
    "frontendDist": "../../web"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' http://127.0.0.1:*",
        "connect-src": "'self' http://127.0.0.1:*",
        "frame-src": "http://127.0.0.1:*",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns"],
    "resources": {
      "../../server/": "studio/server",
      "../../integrations/": "studio/integrations",
      "../../web/": "studio/web"
    }
  }
}
