#!/bin/sh
set -eu

STUDIO_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
PNPM_BIN=${SHAWN_PPT_STUDIO_PNPM:-$(command -v pnpm || true)}
NODE_DIR=${SHAWN_PPT_STUDIO_NODE_DIR:-$(dirname "${SHAWN_PPT_STUDIO_NODE:-$(command -v node || true)}")}

if [ -z "$PNPM_BIN" ] || [ ! -x "$PNPM_BIN" ]; then
  echo "pnpm is required. Install it with Corepack or set SHAWN_PPT_STUDIO_PNPM." >&2
  exit 127
fi
if [ -z "$NODE_DIR" ] || [ ! -x "$NODE_DIR/node" ]; then
  echo "Node.js 24 is required. Set SHAWN_PPT_STUDIO_NODE or SHAWN_PPT_STUDIO_NODE_DIR." >&2
  exit 127
fi

export SHAWN_PPT_STUDIO_ROOT="$STUDIO_ROOT"
export PATH="$NODE_DIR:$PATH"
cd "$STUDIO_ROOT/desktop"
exec "$PNPM_BIN" tauri dev
