#!/bin/sh
set -eu

STUDIO_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
PNPM_BIN=${SHAWN_PPT_STUDIO_PNPM:-$(command -v pnpm || true)}
NODE_DIR=${SHAWN_PPT_STUDIO_NODE_DIR:-$(dirname "${SHAWN_PPT_STUDIO_NODE:-$(command -v node || true)}")}
SIGNING_IDENTITY=${SHAWN_PPT_STUDIO_SIGNING_IDENTITY:-${PPT_AI_LAB_SIGNING_IDENTITY:-}}
if [ -z "$SIGNING_IDENTITY" ] && security find-identity -v -p codesigning 2>/dev/null | grep -Fq '"Shawn PPT Studio Local Signing"'; then
  SIGNING_IDENTITY="Shawn PPT Studio Local Signing"
fi

# Never silently replace an installed app's privacy identity with an ad-hoc build.
if [ -z "$SIGNING_IDENTITY" ] || [ "$SIGNING_IDENTITY" = "-" ]; then
  if [ "${SHAWN_PPT_STUDIO_ALLOW_ADHOC:-0}" != "1" ]; then
    echo "A persistent code-signing identity is required. Set SHAWN_PPT_STUDIO_SIGNING_IDENTITY. For an explicit local-only test build, set SHAWN_PPT_STUDIO_ALLOW_ADHOC=1; replacing the installed app may require macOS permissions again." >&2
    exit 1
  fi
  SIGNING_IDENTITY=-
  echo "WARNING: explicit ad-hoc test build; macOS permission continuity is not guaranteed." >&2
fi

if [ -z "$PNPM_BIN" ] || [ ! -x "$PNPM_BIN" ]; then
  echo "pnpm is required. Install it with Corepack or set SHAWN_PPT_STUDIO_PNPM." >&2
  exit 127
fi
if [ -z "$NODE_DIR" ] || [ ! -x "$NODE_DIR/node" ]; then
  echo "Node.js 24 is required. Set SHAWN_PPT_STUDIO_NODE or SHAWN_PPT_STUDIO_NODE_DIR." >&2
  exit 127
fi

export PATH="$NODE_DIR:$PATH"
export PYTHONDONTWRITEBYTECODE=1
# Local pipeline tests may leave interpreter caches in the fallback Skill.
# These generated files carry machine-specific paths and are never app assets.
python3 - "$STUDIO_ROOT/.agents/skills/shawn-ppt-image/scripts" <<'PY'
from pathlib import Path
import shutil
import sys

root = Path(sys.argv[1])
for cache in root.rglob("__pycache__"):
    if cache.is_dir() and not cache.is_symlink():
        shutil.rmtree(cache)
PY
python3 "$STUDIO_ROOT/tests/desktop/bundle-resource-hygiene.py"
cd "$STUDIO_ROOT/desktop"
if [ ! -x node_modules/.bin/tauri ]; then
  "$PNPM_BIN" install --frozen-lockfile
fi
"$PNPM_BIN" tauri build

APP="$STUDIO_ROOT/desktop/src-tauri/target/release/bundle/macos/Shawn PPT Studio.app"
if [ -d "$APP" ] && command -v codesign >/dev/null 2>&1; then
  codesign --force --deep --sign "$SIGNING_IDENTITY" "$APP"
  codesign --verify --deep --strict "$APP"
fi

test -x "$APP/Contents/MacOS/shawn-ppt-studio"
test -f "$APP/Contents/Resources/studio/server/server.mjs"
test -f "$APP/Contents/Resources/studio/web/index.html"
test -d "$APP/Contents/Resources/studio/integrations"
python3 "$STUDIO_ROOT/tests/desktop/bundle-resource-hygiene.py" --app "$APP"
echo "Built local development app: $APP"
echo "Distribution note: this build is not Developer ID signed or notarized unless an identity is supplied."
